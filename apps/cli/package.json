{
	"name": "@repo/cli",
	"version": "0.1.0-alpha.2",
	"private": true,
	"bin": {
		"cms": "./bin/run.js"
	},
	"type": "module",
	"imports": {
		"#cli/*": {
			"types": "./src/*.ts",
			"default": "./dist/*.js"
		}
	},
	"exports": {
		"./package.json": "./package.json",
		"./config": {
			"types": "./dist/config.d.ts",
			"default": "./dist/config.js"
		},
		"./db/schema": {
			"types": "./dist/db/schema.d.ts",
			"default": "./dist/db/schema.js"
		}
	},
	"scripts": {
		"build": "tsrs -p tsconfig.build.json",
		"typecheck": "tsrs --noEmit -p tsconfig.json",
		"test": "vitest run --exclude scripts/product-consumer-typecheck.test.ts",
		"test:product-consumer": "vitest run scripts/product-consumer-typecheck.test.ts"
	},
	"dependencies": {
		"@oclif/core": "^5.1.7",
		"@repo/config": "workspace:*",
		"@repo/core": "workspace:*",
		"drizzle-kit": "^0.31.11",
		"jiti": "^2.7.0",
		"semver": "^7.8.5",
		"wrangler": "^4.149.0"
	},
	"devDependencies": {
		"@types/node": "^26.6.5",
		"@types/semver": "^7.8.0",
		"mdast-util-from-markdown": "^2.1.0",
		"vitest": "^5.0.3"
	}
}
