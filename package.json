{
	"name": "@repo/root",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"changeset": "changeset",
		"changeset:status": "changeset status",
		"changeset:version": "changeset version && node apps/cli/scripts/migration-release-metadata.ts --generate && pnpm install --lockfile-only && pnpm format",
		"typecheck": "pnpm run typecheck:scripts && pnpm -r typecheck",
		"typecheck:scripts": "tsc --noEmit -p tsconfig.scripts.json",
		"verify": "pnpm run check && pnpm run typecheck && pnpm -r test && pnpm -r build",
		"build:product": "node scripts/product.ts build",
		"pack:product": "node scripts/product.ts pack",
		"check": "oxlint --deny-warnings && oxfmt --check && cspell .",
		"fix": "oxlint --fix && pnpm format",
		"format": "oxfmt && node scripts/sort-txt.ts cspell.txt",
		"fmt": "pnpm format",
		"prepare": "lefthook install && pnpm -r typegen"
	},
	"devDependencies": {
		"@changesets/cli": "^3.0.3",
		"@changesets/config": "^4.0.1",
		"@types/node": "^26.6.5",
		"cspell": "^10.3.6",
		"lefthook": "^2.2.1",
		"oxfmt": "^0.72.0",
		"oxlint": "^1.87.0",
		"oxlint-tsgolint": "^7.0.2004",
		"typescript": "^7.0.2"
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "12.11.2",
			"onFail": "download"
		},
		"runtime": {
			"name": "node",
			"version": "26.11.1",
			"onFail": "download"
		}
	},
	"packageManager": "pnpm@12.11.2"
}
