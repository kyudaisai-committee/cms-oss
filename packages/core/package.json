{
	"name": "@repo/core",
	"version": "0.1.0-alpha.2",
	"private": true,
	"type": "module",
	"imports": {
		"#core/*": {
			"types": "./src/*.js",
			"default": "./src/*"
		}
	},
	"exports": {
		"./dto": "./src/dto.ts",
		"./errors": "./src/errors.ts",
		"./input": "./src/input.ts",
		"./import-plan": "./src/import-plan.ts",
		"./repository.server": "./src/repository.server.ts",
		"./service.server": "./src/service.server.ts",
		"./types": "./src/types.ts",
		"./db.server": "./src/db.server.ts",
		"./db/schema": "./src/db/schema.ts"
	},
	"scripts": {
		"build": "tsrs -p tsconfig.json --noEmit false --declaration false --rootDir src --outDir dist",
		"typecheck": "tsrs --noEmit -p tsconfig.json",
		"test": "vitest run"
	},
	"dependencies": {
		"drizzle-orm": "^0.45.4",
		"server-only": "^0.0.1",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@types/node": "^26.6.5",
		"drizzle-kit": "^0.31.11",
		"vitest": "^5.0.3"
	}
}
