		"@repo/config": "workspace:*",
		"@repo/core": "workspace:*",
		"@repo/editor": "workspace:*",
		"@rolldown/plugin-babel": "^0.2.4",
		"@tailwindcss/vite": "4.3.3",
		"@tanstack/react-form": "^1.33.5",
		"@vitejs/plugin-react": "^6.1.2",
		"babel-plugin-react-compiler": "^1.0.0",
		"clsx": "^2.1.1",
		"date-fns": "^4.4.0",
