{
	"name": "@repo/config",
	"version": "0.1.0-alpha.0",
	"private": true,
	"type": "module",
	"imports": {
		"#config/*": {
			"types": "./src/*.js",
			"default": "./src/*"
		}
	},
	"exports": {
		".": "./src/index.ts"
	},
	"scripts": {
		"build": "tsc -p tsconfig.json --noEmit false --declaration false --rootDir src --outDir dist",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"test": "vitest run"
	},
	"dependencies": {
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "^1.63.1",
		"@types/node": "^26.6.5",
		"typescript": "^7.0.2",
		"vitest": "^5.0.3"
	}
}
