root = true

[*]
charset = utf-8

[*.{ts,tsx,mts,cts,js,jsx,mjs,cjs,json,jsonc,css,vue}]
indent_style = tab
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{md,mdx}]
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = false

[*.{yml,yaml,toml}]
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true
