{
	"compilerOptions": {
		"strict": true,
		"target": "esnext",
		"noEmit": true,
		"isolatedModules": true,
		"moduleDetection": "force",
		"esModuleInterop": true,
		"module": "esnext",
		"moduleResolution": "bundler",
		"rewriteRelativeImportExtensions": true,
		"skipLibCheck": true,
		"noUncheckedIndexedAccess": true,
		"exactOptionalPropertyTypes": true,
		"jsx": "react-jsx"
	}
}
